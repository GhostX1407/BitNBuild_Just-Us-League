# ResQGrid Backend — Environment Configuration Example
# Copy to .env and fill in real values. Blank = mock/fallback mode (no external calls).

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./resq.db

# ── LLM — Groq (primary) ────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── LLM — Gemini (fallback) ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ── RBAC ────────────────────────────────────────────────────────────────────
DEFAULT_ROLE=citizen

# ── Twilio SMS ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DEFAULT_SMS_TO=

# ── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DEFAULT_EMAIL_TO=

# ── SLA & Dispatch ───────────────────────────────────────────────────────────
# Multiplier on SLA minutes (e.g. 0.1 for demo speed)
SLA_TIME_SCALE=1.0
# Auto-dispatch P1 incidents without dispatcher approval
AUTO_DISPATCH_P1=False

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed; defaults include localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Geography defaults (Vadodara) ────────────────────────────────────────────
DEFAULT_CITY_LAT=22.30
DEFAULT_CITY_LNG=73.19

# ── LLM tuning ───────────────────────────────────────────────────────────────
LLM_TIMEOUT_S=4.0

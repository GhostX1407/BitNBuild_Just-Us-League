# =============================================================================
# Smart Disaster & Emergency Management Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# psycopg is required for the async SQLAlchemy engine.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./disaster.db

# -----------------------------------------------------------------------------
# Test database — uses SQLite so no PostgreSQL is required for CI.
# Leave as-is unless you want to run tests against a real PG database.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_disaster.db

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins.
# Phase 4 React dev server default: http://localhost:5173
# DO NOT use * in production.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Default incident severity assigned when the reporter does not supply one.
# Phase 2 will replace this with AI classification.
# Allowed values: Low | Medium | High
# -----------------------------------------------------------------------------
DEFAULT_SEVERITY=Medium

# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------
APP_ENV=development          # development | production
APP_DEBUG=true
APP_TITLE=Disaster & Emergency Management API
APP_VERSION=1.0.0

# =============================================================================
# Phase 3: Notification System
# =============================================================================

# -----------------------------------------------------------------------------
# Master notification switch. Set to false to silence all alerts globally.
# -----------------------------------------------------------------------------
NOTIFICATION_ENABLED=true

# -----------------------------------------------------------------------------
# Comma-separated severity levels that trigger an emergency alert.
# Allowed values: High | Medium | Low   (case-sensitive)
# Default: only High incidents alert responders.
# -----------------------------------------------------------------------------
NOTIFY_ON_SEVERITIES=High

# -----------------------------------------------------------------------------
# Comma-separated list of emergency responder groups shown in each alert.
# These are informational labels — not phone numbers (see Twilio below).
# -----------------------------------------------------------------------------
EMERGENCY_HANDLERS=Police,Fire Department,Medical Response

# -----------------------------------------------------------------------------
# Twilio SMS (OPTIONAL)
# Leave all TWILIO_* variables blank to use the mock/console dispatcher.
# To enable real SMS:
#   1. pip install twilio
#   2. Fill in the four variables below with your Twilio credentials.
# NEVER commit real credentials to version control.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=       # E.164 format, e.g. +15005550006
TWILIO_TO_NUMBERS=        # Comma-separated E.164 numbers, e.g. +919876543210,+911234567890

